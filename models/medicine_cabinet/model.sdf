<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="medicine_cabinet_with_doors">
    <static>false</static>

    <!-- ==================== MAIN CABINET FRAME ==================== -->
    <link name="main_frame">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>15.0</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>15.0</iyy><iyz>0.0</iyz>
          <izz>10.0</izz>
        </inertia>
      </inertial>
      
      <collision name="cabinet_collision">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <box>
            <size>1.5 0.5 1.8</size>
          </box>
        </geometry>
      </collision>

      <visual name="outer_shell_visual">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <box>
            <size>1.5 0.5 1.8</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/White</name>
          </script>
        </material>
      </visual>

      <visual name="lower_drawers_visual">
        <pose>0 0.01 0.35 0 0 0</pose>
        <geometry>
          <box>
            <size>1.46 0.49 0.65</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      
      <visual name="frame_divider">
        <pose>0 0.246 1.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.06 0.02 0.9</size>
          </box>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
    </link>

    <!-- LOCKS MAIN FRAME TO THE WORLD GRID -->
    <joint name="world_joint" type="fixed">
      <parent>world</parent>
      <child>main_frame</child>
    </joint>

    <!-- ==================== LEFT DOOR ==================== -->
    <link name="left_door">
      <!-- Positioned so the edge aligns with the hinge point -->
      <pose>-0.36 0.25 1.2 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.2</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.2</iyy><iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="left_door_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.65 0.02 0.9</size>
          </box>
        </geometry>
      </collision>

      <visual name="left_door_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.65 0.02 0.9</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.5 0.7 0.3</ambient>
          <diffuse>0.0 0.5 0.7 0.3</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- LEFT HINGE JOINT -->
    <joint name="left_hinge" type="revolute">
      <parent>main_frame</parent>
      <child>left_door</child>
      <!-- Hinge anchor placed on the far left edge of the door frame -->
      <axis>
        <xyz>0 0 1</xyz> <!-- Rotates around Z axis -->
        <limit>
          <lower>-1.5708</lower> <!-- Opens out 90 degrees -->
          <upper>0.0</upper>      <!-- Stops completely closed -->
          <effort>10.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <friction>0.5</friction> <!-- Adds physical resistance to movement -->
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== RIGHT DOOR ==================== -->
    <link name="right_door">
      <pose>0.36 0.25 1.2 0 0 0</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.2</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.2</iyy><iyz>0.0</iyz>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="right_door_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.65 0.02 0.9</size>
          </box>
        </geometry>
      </collision>

      <visual name="right_door_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.65 0.02 0.9</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.5 0.7 0.3</ambient>
          <diffuse>0.0 0.5 0.7 0.3</diffuse>
          <specular>1.0 1.0 1.0 1.0</specular>
        </material>
      </visual>
    </link>

    <!-- RIGHT HINGE JOINT -->
    <joint name="right_hinge" type="revolute">
      <parent>main_frame</parent>
      <child>right_door</child>
      <!-- Hinge anchor placed on the far right edge of the door frame -->
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.5708</upper> <!-- Opens out 90 degrees in the opposite direction -->
          <effort>10.0</effort>
          <velocity>1.0</velocity>
        </limit>
        <dynamics>
          <friction>0.5</friction>
          <damping>0.1</damping>
        </dynamics>
      </axis>
    </joint>

  </model>
</sdf>