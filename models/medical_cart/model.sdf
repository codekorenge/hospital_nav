<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="medical_cart">
    <static>false</static>
    <link name="chassis">
      <pose>0 0 0.55 0 0 0</pose>
      <inertial>
        <mass>25.0</mass>
        <inertia>
          <ixx>1.2</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.2</iyy>
          <iyz>0</iyz>
          <izz>0.8</izz>
        </inertia>
      </inertial>

      <!-- Main Red Body -->
      <collision name="body_collision">
        <geometry>
          <box>
            <size>0.6 0.5 0.8</size>
          </box>
        </geometry>
      </collision>
      <visual name="body_visual">
        <geometry>
          <box>
            <size>0.6 0.5 0.8</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.1 0.1 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- White Countertop -->
      <visual name="top_visual">
        <pose>0 0 0.405 0 0 0</pose>
        <geometry>
          <box>
            <size>0.62 0.52 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <!-- Drawers (Visual accents) -->
      <visual name="drawer_1">
        <pose>0.301 0 0.25 0 0 0</pose>
        <geometry><box><size>0.01 0.42 0.12</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="drawer_2">
        <pose>0.301 0 0.10 0 0 0</pose>
        <geometry><box><size>0.01 0.42 0.12</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>
      <visual name="drawer_3">
        <pose>0.301 0 -0.05 0 0 0</pose>
        <geometry><box><size>0.01 0.42 0.12</size></box></geometry>
        <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
      </visual>

      <!-- Push Handle -->
      <collision name="handle_collision">
        <pose>-0.33 0 0.3 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.4</length></cylinder></geometry>
      </collision>
      <visual name="handle_visual">
        <pose>-0.33 0 0.3 0 1.5707 0</pose>
        <geometry><cylinder><radius>0.015</radius><length>0.4</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
      </visual>

      <!-- IV Pole -->
      <collision name="iv_pole_collision">
        <pose>-0.25 -0.2 0.7 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.6</length></cylinder></geometry>
      </collision>
      <visual name="iv_pole_visual">
        <pose>-0.25 -0.2 0.7 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.6</length></cylinder></geometry>
        <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
      </visual>
    </link>

    <!-- Macro-like definitions for the 4 wheels -->
    <link name="wheel_fl">
      <pose>0.22 0.18 0.075 0 1.5707 1.5707</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_fr">
      <pose>0.22 -0.18 0.075 0 1.5707 1.5707</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_bl">
      <pose>-0.22 0.18 0.075 0 1.5707 1.5707</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="wheel_br">
      <pose>-0.22 -0.18 0.075 0 1.5707 1.5707</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.075</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- Joints mapping wheels to the chassis -->
    <joint name="joint_fl" type="revolute">
      <parent>chassis</parent>
      <child>wheel_fl</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="joint_fr" type="revolute">
      <parent>chassis</parent>
      <child>wheel_fr</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="joint_bl" type="revolute">
      <parent>chassis</parent>
      <child>wheel_bl</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="joint_br" type="revolute">
      <parent>chassis</parent>
      <child>wheel_br</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
  </model>
</sdf>